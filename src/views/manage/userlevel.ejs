<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Promotion List</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback"
    />
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-default@5.0.15/default.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-minimal/minimal.css"
    />
    <link rel="stylesheet" href="/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <style>
      .block-click { pointer-events: none; }

      body {
        background-color: #f4f6f9;
        color: #343a40;
      }

      a {
        color: #00807c;
        text-decoration: none;
        background-color: #192434;
        padding: 8px 12px;
        border-radius: 4px;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      [class*="sidebar-dark-"] .sidebar a { color: #9cc6ff; }

      a:hover {
        background-color: #22baa6;
        color: white;
      }

      .bg-primary { background-color: #374992 !important; }
      .dark-mode .nav-pills .nav-link { color: #9cc6ff; }
      .nav-pills .nav-link { color: #00807c; }

      .navbar-light {
        background-color: #e3f2fd;
        border-color: #dee2e6;
      }

      .active { background-color: #71b1f5 !important; }

      button, input, optgroup, select, textarea {
        margin: 4px;
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
      }

      .content-wrapper { background-color: #f8f9fa; }

      .table td, .table th {
        padding: 0.75rem;
        vertical-align: middle;
        border-top: 1px solid #dee2e6;
      }

      thead tr { background-color: #00807c; }
      thead tr th {
        background-color: #00807c;
        color: white;
        font-weight: 600;
      }

      tbody tr:nth-child(odd) { background: #dff5f5 !important; }
      tbody tr:nth-child(even) { background: #ffffff !important; }
      tbody tr:hover {
        background: #c9ecec !important;
        transition: background 0.2s ease;
      }

      .card-header {
        background-color: #ffffff;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        padding: 0.75rem 1.25rem;
        position: relative;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
      }

      .content .card { background-color: #ffffff !important; }

      .form-group {
        text-align: center;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin: 15px;
      }

      .form-group .d-flex {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-bottom: 15px;
      }

      .form-control {
        padding: 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 16px;
        color: #343a40;
      }

      #search {
        width: 100%;
        max-width: 500px;
        height: 48px;
        border: 2px solid #ced4da;
        border-radius: 10px;
        font-size: 16px;
        color: #343a40;
        padding: 0 12px;
      }

      #search:focus {
        outline: none;
        border-color: #00807c;
        box-shadow: 0 0 4px rgba(0, 123, 255);
      }

      #searchBtn {
        background-color: #00807c;
        color: white;
        min-width: 10rem;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        padding: 10px 20px;
        transition: background-color 0.3s ease;
      }

      #searchBtn:hover { background-color: #00625e; }

      .btn-primary {
        padding: 10px 20px;
        background-color: #00807c;
        border: none;
        border-radius: 4px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
      }

      .btn-primary:hover { background-color: #4d49d7; }

      .card-title {
        color: #00807c;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
      }

      .stat-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        height: 100%;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      }

      .stat-card h2 {
        color: #00807c;
        font-size: 1.8rem;
        font-weight: bold;
        margin: 0 0 5px 0;
      }

      .stat-card p {
        color: #015956;
        font-size: 14px;
        margin: 0;
      }

      /* ============ PAGINATION ============ */
      #paginationContainer {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 20px 0;
      }

      #paginationContainer .page-item { margin: 0; }

      .pagedeg {
        display: inline-block;
        padding: 8px 14px;
        border: none;
        background: #e9ecef !important;
        color: #00807c !important;
        cursor: pointer;
        border-radius: 6px;
        font-size: 15px;
        font-weight: bold;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease;
      }

      .pagedeg:hover {
        background: #00807c !important;
        color: white !important;
      }

      #paginationContainer .page-item.active .pagedeg {
        background: #00807c !important;
        color: white !important;
      }

      #paginationContainer .page-item.disabled .pagedeg {
        background: #f1f3f5 !important;
        color: #adb5bd !important;
        cursor: not-allowed;
        pointer-events: none;
      }
    </style>
  </head>

  <body class="hold-transition sidebar-mini">
    <div class="wrapper">
      <%- include('nav') %>

      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1 style="color: #00807c; font-size: 2rem; font-weight: bold">
                  User Promotion List
                </h1>
              </div>
            </div>
          </div>
        </section>

        <div class="form-group">
          <div class="d-flex">
            <input
              type="text"
              id="search"
              placeholder="Enter the member you are looking for"
              class="form-control"
            />
            <button id="searchBtn" class="btn btn-primary">Search</button>
          </div>
        </div>

        <section class="content">
          <div class="row" style="padding: 0 10px;">
            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="deposit-number">0</h2>
                <p><i class="fas fa-money-bill-wave"></i> Deposit Number</p>
              </div>
            </div>

            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="deposit-amount">0</h2>
                <p><i class="fas fa-dollar-sign"></i> Deposit Amount</p>
              </div>
            </div>

            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="number-bettor">0</h2>
                <p><i class="fas fa-users"></i> Number of Bettors</p>
              </div>
            </div>

            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="total-bet-amount">0</h2>
                <p><i class="fas fa-chart-line"></i> Total Bet Amount</p>
              </div>
            </div>

            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="first-deposit">0</h2>
                <p><i class="fas fa-user-plus"></i> First Time Depositors</p>
              </div>
            </div>

            <div class="col-md-4 col-sm-6 mb-3">
              <div class="stat-card">
                <h2 id="total-bet">0</h2>
                <p><i class="fas fa-gavel"></i> Total Bet</p>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Member List</h3>
              <div class="card-tools">
                <button
                  type="button"
                  class="btn btn-tool"
                  data-card-widget="collapse"
                  title="Collapse"
                >
                  <i class="fas fa-minus"></i>
                </button>
                <button
                  type="button"
                  class="btn btn-tool"
                  data-card-widget="remove"
                  title="Remove"
                >
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>

            <div class="card-body p-0" style="overflow-x: auto">
              <table class="table table-striped projects" id="table1">
                <thead>
                  <tr>
                    <th class="text-center">#</th>
                    <th class="text-center">User Level</th>
                    <th class="text-center">Total Recharge Amount</th>
                    <th class="text-center">Total Commissions Amount</th>
                    <th class="text-center">Total Bet Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td colspan="5" class="text-center">Loading...</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- PAGINATION -->
            <nav aria-label="User promotion pagination">
              <ul class="pagination" id="paginationContainer"></ul>
            </nav>
          </div>
        </section>
      </div>
    </div>

    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/js/adminlte.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="/js/admin/admin.js"></script>

    <script>
      // ============ CONFIG ============
      const LIMIT = 20;
      let currentPage = 1;

      // ============ HELPERS ============
      const fmt = (val) => {
        const n = Number(val ?? 0);
        return isNaN(n) ? "0" : n.toLocaleString();
      };

      const extractDatas = (response) =>
        response?.datas ||
        response?.data?.gameslist ||
        response?.data?.list ||
        [];

      // ============ RENDER ROWS ============
      const Render = (datas) => {
        let html = "";

        if (!datas || datas.length === 0) {
          html = `<tr><td colspan="5" class="text-center">No members found</td></tr>`;
          $("#table1 tbody").html(html);
          return;
        }

        datas.forEach((data, index) => {
          const rowNo = (currentPage - 1) * LIMIT + index + 1;
          html += `
            <tr class="text-center">
              <td>${rowNo}</td>
              <td>${data.level ?? 0}</td>
              <td><b>${fmt(data.recharge)}</b></td>
              <td><b>${fmt(data.rebate)}</b></td>
              <td><b>${fmt(data.totalRecharge)}</b></td>
            </tr>`;
        });

        $("#table1 tbody").html(html);
      };

      // ============ FETCH ============
      const fetchData = (page = 1) => {
        currentPage = page;

        const value = ($("#search").val() || "").trim();
        const pageno = (page - 1) * LIMIT;

        $.ajax({
          type: "POST",
          url: "/api/webapi/admin/listMember",
          data: {
            id_user: value,
            date: formattedDate,
            page: page,
            pageno: pageno,
            limit: LIMIT,
          },
          dataType: "json",
          success: function (response) {
            console.log("listMember response:", response);

            if (response && (response.status === true || response.code === 0 && response.status !== false)) {
              const datas = extractDatas(response);
              Render(datas);

              // Stats
              $("#deposit-number").text(response?.total_recharge_count ?? 0);
              $("#deposit-amount").text(response?.total_recharge_amount ?? 0);
              $("#number-bettor").text(response?.better_number ?? 0);
              $("#total-bet-amount").text(response?.total_bet_amount ?? 0);
              $("#first-deposit").text(response?.total_first_recharge_count ?? 0);
              $("#total-bet").text(response?.total_bet_count ?? 0);

              // Page total (many possible field names)
              const totalPages =
                Number(response?.page_total) ||
                Number(response?.data?.page_total) ||
                Number(response?.totalPages) ||
                Number(response?.total_pages) ||
                Number(response?.pages) ||
                Number(response?.pagination?.total) ||
                1;

              renderPagination(totalPages, page);
            } else {
              Render([]);
              $("#paginationContainer").html("");
              if (response?.msg) Swal.fire("Info", response.msg, "info");
            }
          },
          error: function (xhr) {
            console.error("Fetch error:", xhr);
            Render([]);
            $("#paginationContainer").html("");
            Swal.fire("Error", "Failed to load member list", "error");
          },
        });
      };

      // ============ PAGINATION ============
      const renderPagination = (pageTotal, currentPageNo) => {
        pageTotal = parseInt(pageTotal) || 1;
        currentPageNo = parseInt(currentPageNo) || 1;

        // Show a single active "1" if only one page
        if (pageTotal <= 1) {
          $("#paginationContainer").html(
            `<li class="page-item active">
               <a class="pagedeg" href="#" data-page="1">1</a>
             </li>`
          );
          bindPagination();
          return;
        }

        const maxVisible = 7;
        let start = Math.max(1, currentPageNo - Math.floor(maxVisible / 2));
        let end = Math.min(pageTotal, start + maxVisible - 1);

        if (end - start + 1 < maxVisible) {
          start = Math.max(1, end - maxVisible + 1);
        }

        let html = "";

        // First
        html += `<li class="page-item ${currentPageNo === 1 ? "disabled" : ""}">
                   <a class="pagedeg" href="#" data-page="1">« First</a>
                 </li>`;

        // Prev
        html += `<li class="page-item ${currentPageNo === 1 ? "disabled" : ""}">
                   <a class="pagedeg" href="#" data-page="${currentPageNo - 1}">‹ Prev</a>
                 </li>`;

        // Numbers
        for (let i = start; i <= end; i++) {
          html += `<li class="page-item ${i === currentPageNo ? "active" : ""}">
                     <a class="pagedeg" href="#" data-page="${i}">${i}</a>
                   </li>`;
        }

        // Next
        html += `<li class="page-item ${currentPageNo === pageTotal ? "disabled" : ""}">
                   <a class="pagedeg" href="#" data-page="${currentPageNo + 1}">Next ›</a>
                 </li>`;

        // Last
        html += `<li class="page-item ${currentPageNo === pageTotal ? "disabled" : ""}">
                   <a class="pagedeg" href="#" data-page="${pageTotal}">Last »</a>
                 </li>`;

        $("#paginationContainer").html(html);
        bindPagination();
      };

      const bindPagination = () => {
        $("#paginationContainer")
          .off("click", ".pagedeg")
          .on("click", ".pagedeg", function (e) {
            e.preventDefault();
            const p = parseInt($(this).data("page"), 10);
            if (isNaN(p) || p < 1 || p === currentPage) return;
            fetchData(p);
            $("html, body").animate({ scrollTop: 0 }, 200);
          });
      };

      // ============ EVENTS ============
      $("#searchBtn").click(function () {
        fetchData(1);
      });

      $("#search").on("keypress", function (e) {
        if (e.which === 13) {
          e.preventDefault();
          fetchData(1);
        }
      });

      // ============ INIT ============
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      const formattedDate = yesterday.toISOString().split("T")[0];

      $(document).ready(function () {
        fetchData(1);
      });
    </script>

    <script
      src="https://kit.fontawesome.com/5c9f82cc45.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>