<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.1/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color-light: #5ccfcb;
            --primary-color-dark: #00807c;
            --main-bg: #f5f8fc;
            --card-bg: #fbfdff;
            --text-dark: #344760;
            --text-medium: #627b87;
            --border-light: #d1e2eb;
            --input-bg-light: #eff4f8;
            --shadow-subtle: rgba(0, 0, 0, 0.04);
            --shadow-medium: rgba(0, 0, 0, 0.08);
        }

        body {
            background-color: var(--main-bg);
            font-family: 'Poppins', sans-serif;
            color: var(--text-dark);
        }

        .content-wrapper { background-color: var(--main-bg); }

        .card {
            background-color: var(--card-bg);
            border-radius: 10px;
            box-shadow: 0 4px 15px var(--shadow-subtle);
            border: 1px solid var(--border-light);
            margin-bottom: 30px;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px var(--shadow-medium);
        }
        .card-header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-light);
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }
        .card-title {
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0;
        }
        .form-group { margin-bottom: 20px; }
        .form-group label {
            font-weight: 500;
            color: var(--text-dark);
            margin-bottom: 8px;
            display: block;
        }
        .form-control {
            border-radius: 5px;
            border: 1px solid var(--border-light);
            padding: 12px 15px;
            font-size: 1rem;
            color: var(--text-dark);
            background-color: var(--input-bg-light);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            height: calc(1.5em + 12px * 2 + 2px);
        }
        .form-control:focus {
            border-color: var(--primary-color-light);
            box-shadow: 0 0 0 0.2rem rgba(92, 207, 203, 0.25);
            outline: none;
            background-color: var(--card-bg);
        }
        .input-group-append .btn {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            background-color: var(--border-light);
            border-color: var(--border-light);
            color: var(--text-medium);
            padding: 12px 15px;
            height: calc(1.5em + 12px * 2 + 2px);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .input-group-append .btn:hover {
            background-color: #c4d7e3;
            border-color: #c4d7e3;
            color: var(--text-dark);
        }
        .btn-primary {
            background-color: var(--primary-color-light);
            border-color: var(--primary-color-light);
            padding: 10px 25px;
            font-size: 1.05rem;
            font-weight: 600;
            border-radius: 5px;
            transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
        }
        .btn-primary:hover {
            background-color: var(--primary-color-dark);
            border-color: var(--primary-color-dark);
            transform: translateY(-1px);
        }
        .btn-outline-secondary {
            color: var(--text-medium);
            border-color: var(--border-light);
            background-color: var(--card-bg);
            padding: 10px 20px;
            font-size: 0.95rem;
            font-weight: 500;
            border-radius: 5px;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }
        .btn-outline-secondary:hover {
            background-color: var(--input-bg-light);
            color: var(--text-dark);
            border-color: var(--text-medium);
        }

        .table { margin-bottom: 0; }
        .table th, .table td {
            vertical-align: middle;
            padding: 15px 25px;
            border-top: 1px solid var(--border-light);
        }
        .table tbody tr:nth-of-type(odd) { background-color: #fcfdfe; }
        .table thead th {
            border-bottom: 2px solid var(--border-light);
            font-weight: 600;
            color: var(--text-medium);
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }

        .user-level-select {
            padding: 6px 10px;
            border-radius: 5px;
            border: 1px solid var(--border-light);
            background-color: var(--input-bg-light);
            color: var(--text-dark);
            font-weight: 500;
            cursor: pointer;
            min-width: 110px;
        }

        .btn-delete-user {
            background-color: #e57373;
            border-color: #e57373;
            color: #fff;
            border-radius: 5px;
            padding: 6px 12px;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .btn-delete-user:hover {
            background-color: #c62828;
            border-color: #c62828;
            color: #fff;
        }

        @media (max-width: 767.98px) {
            .content-wrapper { padding: 15px; }
            .card-header {
                flex-direction: column;
                align-items: flex-start;
                padding: 15px 20px;
            }
            .card-title { font-size: 1.5rem; margin-bottom: 15px; }
            .d-flex.justify-content-start { flex-direction: column; }
            .d-flex.justify-content-start .btn {
                width: 100%;
                margin-bottom: 10px;
                margin-right: 0 !important;
            }
            .content-header .col-sm-6 { text-align: center !important; }
            .content-header .col-sm-6:first-child { margin-bottom: 15px; }
            .table th, .table td { padding: 10px 15px; font-size: 0.9rem; }
        }

        .swal2-popup {
            border-radius: 10px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
            background: var(--card-bg) !important;
        }
        .swal2-title { color: var(--text-dark) !important; font-weight: 600 !important; }
        .swal2-html-container { color: var(--text-medium) !important; }
        .swal2-styled.swal2-confirm {
            background-color: var(--primary-color-dark) !important;
            border: none !important;
            border-radius: 5px !important;
            font-weight: 600 !important;
        }
        .swal2-styled.swal2-cancel {
            background-color: #dc3545 !important;
            border: none !important;
            border-radius: 5px !important;
            font-weight: 600 !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
    <%- include('../nav') %>

    <div class="content-wrapper" style="min-height: 500px;">
        <section class="content-header">
            <div class="container-fluid">
                <div class="row mb-4 align-items-center">
                    <div class="col-sm-6">
                        <h1 class="m-0">User Management</h1>
                    </div>
                    <div class="col-sm-6 text-sm-right mt-3 mt-sm-0">
                        <button id="hideFormBtn" class="btn btn-outline-secondary">
                            Hide Form <i class="material-symbols-outlined ml-1">keyboard_arrow_up</i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section class="content">
            <div class="container-fluid">

                <!-- CREATE USER FORM -->
                <div class="card" id="userFormCard">
                    <div class="card-header" style="color: white; background: #00807c;">
                        <h3 class="card-title" style="color: white;">Create New User</h3>
                    </div>
                    <div class="card-body">
                        <form id="createUserForm">
                            <div class="form-group">
                                <label for="mobileNumber">Mobile Number</label>
                                <input type="text" class="form-control" id="mobileNumber" placeholder="Enter Mobile Number (9-10 digits)" required>
                            </div>
                            <div class="form-group">
                                <label for="password">Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="password" placeholder="Enter Password" required>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                            <i class="material-symbols-outlined">visibility</i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="accountType">Account Type</label>
                                <select class="form-control" id="accountType" required>
                                    <option value="">Select Account Type</option>
                                    <option value="1">Admin</option>
                                    <option value="2">Manager</option>
                                    <option value="3">Staff</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="userLevel">Status</label>
                                <select class="form-control" id="userLevel" required>
                                    <option value="1" selected>Active</option>
                                    <option value="0">Inactive</option>
                                </select>
                            </div>
                            <div class="d-flex flex-column flex-sm-row justify-content-start mt-4">
                                <button type="submit" class="btn btn-primary mr-sm-3 mb-2 mb-sm-0">Create Role-Based User</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- USER LIST -->
                <div class="card">
                    <div class="card-header" style="background: #00807c; color: white;">
                        <h3 class="card-title" style="color: white;">Admin Users (<span id="userCount">0</span>)</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="white-space: nowrap;">Username</th>
                                        <th style="white-space: nowrap;">Mobile</th>
                                        <th style="white-space: nowrap;">Account Type</th>
                                        <th style="white-space: nowrap;">Invite Code</th>
                                        <th style="white-space: nowrap;">Created At</th>
                                        <th style="white-space: nowrap;">Level</th>
                                        <th style="white-space: nowrap;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="usersTableBody">
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">Loading...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap 4.6.2 -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<!-- AdminLTE 3.1 -->
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.1/dist/js/adminlte.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>

<script>
$(document).ready(function () {

    // ============================================
    // RENDER USERS TABLE — This was MISSING before!
    // ============================================
    function renderUsersTable(users) {
        const tbody = $("#usersTableBody");
        tbody.empty();

        if (!users || users.length === 0) {
            tbody.append(
                '<tr><td colspan="7" class="text-center text-muted py-4">No users found</td></tr>'
            );
            $("#userCount").text(0);
            return;
        }

        users.forEach(function (user) {
            const levelSelect = `
                <select class="user-level-select" data-id="${user.id}" data-previous-value="${user.level}">
                    <option value="1" ${user.level === 1 ? "selected" : ""}>Active</option>
                    <option value="0" ${user.level === 0 ? "selected" : ""}>Inactive</option>
                </select>
            `;

            tbody.append(`
                <tr>
                    <td>${user.username || "-"}</td>
                    <td>${user.mobile || "-"}</td>
                    <td>${user.accountType || "-"}</td>
                    <td>${user.inviteCode || "-"}</td>
                    <td>${user.dateCreated || "-"}</td>
                    <td>${levelSelect}</td>
                    <td>
                        <button class="btn btn-sm btn-delete-user delete-user-btn" data-id="${user.id}">
                            <i class="fa fa-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            `);
        });

        $("#userCount").text(users.length);
    }

    // ============================================
    // FETCH USERS
    // ============================================
    function fetchAdminUsers() {
        $.ajax({
            url: "/admin/users/list",
            method: "GET",
            dataType: "json",
            success: function (response) {
                if (response.status) {
                    renderUsersTable(response.data);
                } else {
                    $("#usersTableBody").html(
                        '<tr><td colspan="7" class="text-center text-danger py-4">' +
                        (response.message || "Failed to fetch users") +
                        "</td></tr>"
                    );
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: response.message || "Failed to fetch users",
                        confirmButtonColor: "#00807c",
                    });
                }
            },
            error: function (xhr) {
                console.error("Fetch users error:", xhr.responseText);
                $("#usersTableBody").html(
                    '<tr><td colspan="7" class="text-center text-danger py-4">Failed to load users. Check console.</td></tr>'
                );
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Failed to fetch users. Please check server logs.",
                    confirmButtonColor: "#00807c",
                });
            },
        });
    }

    // Initial load
    fetchAdminUsers();

    // ============================================
    // TOGGLE FORM
    // ============================================
    $("#hideFormBtn").on("click", function () {
        $("#userFormCard").slideToggle(function () {
            if ($(this).is(":visible")) {
                $("#hideFormBtn").html(
                    'Hide Form <i class="material-symbols-outlined ml-1">keyboard_arrow_up</i>'
                );
            } else {
                $("#hideFormBtn").html(
                    'Show Form <i class="material-symbols-outlined ml-1">keyboard_arrow_down</i>'
                );
            }
        });
    });

    // ============================================
    // TOGGLE PASSWORD VISIBILITY
    // ============================================
    $("#togglePassword").on("click", function () {
        const passwordField = $("#password");
        const icon = $("#togglePassword i");
        if (passwordField.attr("type") === "password") {
            passwordField.attr("type", "text");
            icon.text("visibility_off");
        } else {
            passwordField.attr("type", "password");
            icon.text("visibility");
        }
    });

    // ============================================
    // CREATE USER
    // ============================================
    $("#createUserForm").on("submit", function (event) {
        event.preventDefault();

        const mobileNumber = $("#mobileNumber").val().trim();
        const password = $("#password").val().trim();
        const accountType = parseInt($("#accountType").val());
        const userLevel = parseInt($("#userLevel").val());

        if (!mobileNumber || !password || !accountType) {
            Swal.fire({
                icon: "error",
                title: "Validation Error",
                text: "Please fill in all required fields.",
                confirmButtonColor: "#00807c",
            });
            return;
        }

        if (mobileNumber.length < 9 || mobileNumber.length > 10) {
            Swal.fire({
                icon: "error",
                title: "Validation Error",
                text: "Mobile number must be 9-10 digits.",
                confirmButtonColor: "#00807c",
            });
            return;
        }

        const submitBtn = $(this).find('button[type="submit"]');
        submitBtn
            .prop("disabled", true)
            .html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Creating...');

        $.ajax({
            url: "/admin/manager/create/ctv",
            method: "POST",
            dataType: "json",
            data: {
                username: mobileNumber,
                pwd: password,
                level: accountType,
                status: userLevel,
            },
            success: function (response) {
                submitBtn.prop("disabled", false).text("Create Role-Based User");

                if (response.status) {
                    Swal.fire({
                        icon: "success",
                        title: "User Created!",
                        text: "Account has been created successfully.",
                        confirmButtonColor: "#00807c",
                        timer: 1800,
                        showConfirmButton: false,
                    });

                    // Clear form
                    $("#mobileNumber").val("");
                    $("#password").val("");
                    $("#accountType").val("");
                    $("#userLevel").val("1");

                    // ✅ Refresh table so new user shows up
                    fetchAdminUsers();
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: response.message || "Failed to create user",
                        confirmButtonColor: "#00807c",
                    });
                }
            },
            error: function (xhr) {
                submitBtn.prop("disabled", false).text("Create Role-Based User");
                console.error("Create user error:", xhr.responseText);
                let msg = "Failed to create user.";
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    msg = xhr.responseJSON.message;
                }
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: msg,
                    confirmButtonColor: "#00807c",
                });
            },
        });
    });

    // ============================================
    // UPDATE USER LEVEL
    // ============================================
    $("#usersTableBody").on("change", ".user-level-select", function () {
        const selectEl = $(this);
        const userIdToUpdate = selectEl.data("id");
        const newLevel = parseInt(selectEl.val());
        const previousValue = selectEl.data("previous-value");

        $.ajax({
            url: "/admin/users/update-level/" + userIdToUpdate,
            method: "PUT",
            dataType: "json",
            data: { level: newLevel },
            success: function (response) {
                if (response.status) {
                    Swal.fire({
                        icon: "success",
                        title: "Level Updated!",
                        text: `User changed to ${newLevel === 1 ? "Active" : "Inactive"}.`,
                        confirmButtonColor: "#00807c",
                        timer: 1500,
                        showConfirmButton: false,
                    });
                    selectEl.data("previous-value", newLevel);
                    fetchAdminUsers();
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: response.message || "Failed to update user level",
                        confirmButtonColor: "#00807c",
                    });
                    selectEl.val(previousValue);
                }
            },
            error: function (xhr) {
                console.error("Update level error:", xhr.responseText);
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Failed to update user level",
                    confirmButtonColor: "#00807c",
                });
                selectEl.val(previousValue);
            },
        });
    });

    // ============================================
    // DELETE USER (optional — needs backend route)
    // ============================================
    $("#usersTableBody").on("click", ".delete-user-btn", function () {
        const userId = $(this).data("id");

        Swal.fire({
            icon: "warning",
            title: "Are you sure?",
            text: "This user will be permanently deleted!",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel",
        }).then(function (result) {
            if (!result.isConfirmed) return;

            $.ajax({
                url: "/admin/users/delete/" + userId,
                method: "DELETE",
                dataType: "json",
                success: function (response) {
                    if (response.status) {
                        Swal.fire({
                            icon: "success",
                            title: "Deleted!",
                            text: "User has been deleted.",
                            confirmButtonColor: "#00807c",
                            timer: 1500,
                            showConfirmButton: false,
                        });
                        fetchAdminUsers();
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: response.message || "Failed to delete user",
                            confirmButtonColor: "#00807c",
                        });
                    }
                },
                error: function (xhr) {
                    console.error("Delete user error:", xhr.responseText);
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Failed to delete user. Route may not exist yet.",
                        confirmButtonColor: "#00807c",
                    });
                },
            });
        });
    });

});
</script>
</body>
</html>