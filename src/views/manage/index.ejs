  <!-- ================= SOCKET.IO TIMER — wired to server events ================= -->
  <script>
  (function () {
    "use strict";

    if (typeof io === "undefined") {
      console.warn("[Timer] Socket.IO not loaded.");
      return;
    }

    const socket = io();

    // Timer DOM refs
    const min1El = document.getElementById("minute1"); // tens of minutes
    const min2El = document.getElementById("minute2"); // units of minutes
    const sec1El = document.getElementById("sec1");     // tens of seconds
    const sec2El = document.getElementById("sec2");     // units of seconds

    /**
     * Your server emits: { minute, secondtime1, secondtime2 }
     *   minute      = total minutes
     *   secondtime1 = tens digit of seconds (0-5)
     *   secondtime2 = units digit of seconds (0-9)
     *
     * Display as MM : SS — split "minute" into 2 digits.
     */
    function renderDigits(minute, secondtime1, secondtime2) {
      minute = Math.max(0, parseInt(minute, 10) || 0);
      secondtime1 = Math.max(0, Math.min(9, parseInt(secondtime1, 10) || 0));
      secondtime2 = Math.max(0, Math.min(9, parseInt(secondtime2, 10) || 0));

      const minTens = Math.floor(minute / 10) % 10;
      const minUnits = minute % 10;

      if (min1El) min1El.textContent = minTens;
      if (min2El) min2El.textContent = minUnits;
      if (sec1El) sec1El.textContent = secondtime1;
      if (sec2El) sec2El.textContent = secondtime2;
    }

    // ---- Main events from your server ----
    // 1-min game (this page: /admin/manager/index)
    socket.on("timeUpdate_11", function (data) {
      if (!data) return;
      renderDigits(data.minute, data.secondtime1, data.secondtime2);
    });

    // 30-second game (route /admin/manager/index/10)
    socket.on("timeUpdate_30", function (data) {
      if (!data) return;
      renderDigits(data.minute, data.secondtime1, data.secondtime2);
    });

    // 3-min game
    socket.on("timeUpdate_3", function (data) {
      if (!data) return;
      renderDigits(data.minute, data.secondtime1, data.secondtime2);
    });

    // 5-min game
    socket.on("timeUpdate_5", function (data) {
      if (!data) return;
      renderDigits(data.minute, data.secondtime1, data.secondtime2);
    });

    // Latest periods for the table (handled elsewhere too, but logged here)
    socket.on("data-server", function (payload) {
      // console.log("[Timer] data-server:", payload);
    });

    // Diagnostics
    socket.on("connect", function () {
      console.log("[Timer] connected:", socket.id);
    });
    socket.on("disconnect", function (reason) {
      console.warn("[Timer] disconnected:", reason);
    });
    socket.on("connect_error", function (err) {
      console.error("[Timer] connect_error:", err.message);
    });

    // Placeholder until first tick
    renderDigits(0, 0, 0);
  })();
  </script>
  <!-- ================= END SOCKET.IO TIMER ================= -->

